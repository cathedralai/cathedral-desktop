# Cathedral sealed desktop: a headless Linux desktop for computer-use agents.
# Runs under gVisor on the sealed pool. Xvfb + openbox + tint2, x11vnc + noVNC,
# xdotool/scrot for agent actions, Chromium, optional cloudflared tunnel.
# The sealed-pool builder accepts FROM and RUN only (no ENV, COPY, WORKDIR, CMD),
# so the scripts under desktop/ are embedded base64 by build-context.sh.
FROM debian:trixie-slim
RUN export DEBIAN_FRONTEND=noninteractive && apt-get update && apt-get install -y --no-install-recommends \
      ca-certificates curl procps psmisc dbus-x11 \
      xvfb x11-xserver-utils x11-utils x11-apps xdotool scrot imagemagick \
      x11vnc novnc python3 python3-websockify \
      openbox tint2 feh xterm \
      chromium fonts-dejavu fonts-noto-color-emoji \
  && curl -fsSL -o /tmp/cloudflared.deb https://github.com/cloudflare/cloudflared/releases/latest/download/cloudflared-linux-amd64.deb \
  && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends /tmp/cloudflared.deb \
  && rm -rf /var/lib/apt/lists/* /tmp/cloudflared.deb
RUN mkdir -p /opt/desktop /work && convert -size 1280x800 gradient:'#1a1b26-#24283b' \
      -fill '#7aa2f7' -gravity center -pointsize 30 -annotate +0-24 'Cathedral sealed desktop' \
      -fill '#a9b1d6' -pointsize 16 -annotate +0+18 'AMD SEV-SNP  /  gVisor  /  every action receipted' \
      /opt/desktop/wallpaper.png
RUN echo  | base64 -d > /usr/local/bin/desktop-up && echo  | base64 -d > /usr/local/bin/shot && echo  | base64 -d > /usr/local/bin/browser && chmod 755 /usr/local/bin/desktop-up /usr/local/bin/shot /usr/local/bin/browser
