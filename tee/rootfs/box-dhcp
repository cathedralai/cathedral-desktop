#!/bin/busybox sh
# Fallback udhcpc script: configure eth0 from the lease when the distro script is missing.
case "$1" in
  bound|renew)
    ip addr flush dev "$interface" 2>/dev/null
    ip addr add "$ip/${mask:-24}" dev "$interface"
    [ -n "$router" ] && ip route add default via "${router%% *}" dev "$interface" 2>/dev/null
    [ -n "$dns" ] && { : > /etc/resolv.conf; for s in $dns; do echo "nameserver $s" >> /etc/resolv.conf; done; }
    ;;
  deconfig) ip addr flush dev "$interface" 2>/dev/null ;;
esac
exit 0
