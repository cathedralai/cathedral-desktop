# Cathedral openbox theme: flat, dark, one coral accent. Installed to
# /usr/share/themes/Cathedral/openbox-3/themerc by desktop/bootstrap.
border.width: 1
padding.width: 8
padding.height: 5
window.handle.width: 0
window.client.padding.width: 0
window.client.padding.height: 0
window.label.text.justify: left
menu.overlap.x: 0

window.active.border.color: #2E3641
window.inactive.border.color: #1A1F27
window.active.title.separator.color: #151920
window.inactive.title.separator.color: #0F1216

window.active.title.bg: flat solid
window.active.title.bg.color: #151920
window.active.label.bg: parentrelative
window.active.label.text.color: #ECE9E1
window.active.handle.bg: flat solid
window.active.handle.bg.color: #151920
window.active.grip.bg: parentrelative

window.inactive.title.bg: flat solid
window.inactive.title.bg.color: #0F1216
window.inactive.label.bg: parentrelative
window.inactive.label.text.color: #8E9AA6
window.inactive.handle.bg: flat solid
window.inactive.handle.bg.color: #0F1216
window.inactive.grip.bg: parentrelative

window.active.button.unpressed.bg: parentrelative
window.active.button.unpressed.image.color: #D6D2C8
window.active.button.hover.bg: parentrelative
window.active.button.hover.image.color: #F06E4A
window.active.button.pressed.bg: parentrelative
window.active.button.pressed.image.color: #F06E4A
window.active.button.disabled.bg: parentrelative
window.active.button.disabled.image.color: #2E3641
window.active.button.toggled.unpressed.bg: parentrelative
window.active.button.toggled.unpressed.image.color: #D6D2C8

window.inactive.button.unpressed.bg: parentrelative
window.inactive.button.unpressed.image.color: #6B7682
window.inactive.button.hover.bg: parentrelative
window.inactive.button.hover.image.color: #F06E4A
window.inactive.button.pressed.bg: parentrelative
window.inactive.button.pressed.image.color: #F06E4A
window.inactive.button.disabled.bg: parentrelative
window.inactive.button.disabled.image.color: #222831
window.inactive.button.toggled.unpressed.bg: parentrelative
window.inactive.button.toggled.unpressed.image.color: #6B7682

menu.border.width: 1
menu.border.color: #2E3641
menu.title.bg: flat solid
menu.title.bg.color: #0F1216
menu.title.text.color: #8E9AA6
menu.title.text.justify: left
menu.items.bg: flat solid
menu.items.bg.color: #151920
menu.items.text.color: #ECE9E1
menu.items.disabled.text.color: #6B7682
menu.items.active.bg: flat solid
menu.items.active.bg.color: #F06E4A
menu.items.active.text.color: #0B0D11
menu.separator.color: #2E3641
menu.separator.width: 1
menu.separator.padding.width: 8
menu.separator.padding.height: 4

osd.border.width: 1
osd.border.color: #2E3641
osd.bg: flat solid
osd.bg.color: #151920
osd.label.bg: parentrelative
osd.label.text.color: #ECE9E1
osd.hilight.bg: flat solid
osd.hilight.bg.color: #F06E4A
osd.unhilight.bg: flat solid
osd.unhilight.bg.color: #222831
