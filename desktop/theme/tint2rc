# Cathedral panel: top, flat, Inter + JetBrains Mono, one coral accent.
#---- Backgrounds (ids are assigned in order: 1 panel, 2 tooltip, 3 active task)
rounded = 0
border_width = 0
border_sides = B
background_color = #0B0D11 100
border_color = #222831 100

rounded = 6
border_width = 1
background_color = #151920 100
border_color = #2E3641 100

rounded = 6
border_width = 0
background_color = #F06E4A 100
border_color = #F06E4A 100

#---- Panel
panel_items = LTSC
panel_size = 100% 36
panel_margin = 0 0
panel_padding = 12 0 12
panel_background_id = 1
wm_menu = 1
panel_dock = 0
panel_position = top center horizontal
panel_layer = top
panel_monitor = all
strut_policy = follow_size
font_shadow = 0
disable_transparency = 1

#---- Launcher
launcher_padding = 2 4 10
launcher_background_id = 0
launcher_icon_size = 18
launcher_icon_theme = Papirus-Dark
launcher_icon_theme_override = 1
launcher_item_app = /usr/share/applications/cathedral-terminal.desktop
launcher_item_app = /usr/share/applications/cathedral-browser.desktop
startup_notifications = 0

#---- Taskbar
taskbar_mode = single_desktop
taskbar_padding = 8 0 6
taskbar_background_id = 0
taskbar_name = 0

#---- Tasks
task_text = 1
task_icon = 1
task_centered = 0
task_maximum_size = 200 30
task_padding = 10 4 10
task_font = Inter 10
task_font_color = #D6D2C8 100
task_active_font_color = #0B0D11 100
task_urgent_font_color = #0B0D11 100
task_background_id = 0
task_active_background_id = 3
task_urgent_background_id = 3
task_icon_asb = 90 0 0
task_active_icon_asb = 100 0 0
urgent_nb_of_blink = 6

#---- Clock
time1_format = %H:%M
time1_font = JetBrains Mono 10
time2_format = %a %-d %b
time2_font = Inter 9
clock_font_color = #ECE9E1 100
clock_padding = 10 0
clock_background_id = 0

#---- Tray
systray_padding = 6 0 6
systray_background_id = 0
systray_icon_size = 16

#---- Tooltip
tooltip_show_timeout = 0.4
tooltip_hide_timeout = 0.1
tooltip_padding = 8 5
tooltip_background_id = 2
tooltip_font = Inter 9
tooltip_font_color = #ECE9E1 100
